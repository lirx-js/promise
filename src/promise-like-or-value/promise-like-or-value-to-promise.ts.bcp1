import { IPromise } from '../promise/instance/promise.trait-collection';
import { IPromiseValue } from '../promise/promise-value.type';
import { IPromiseLikeOrValue } from './promise-like-or-value.type';

export function promiseLikeOrValueToPromise<GValue>(
  input: IPromiseLikeOrValue<GValue>,
): IPromise<IPromiseValue<GValue>> {
  return new Promise<GValue>((resolve) => {
    resolve(input);
  }) as IPromise<IPromiseValue<GValue>>;
}
